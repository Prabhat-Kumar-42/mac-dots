#!/bin/bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Remove names created by earlier revisions so a reload stays idempotent.
for item in workspace_capsule workspaces_toggle system_capsule system_toggle front_app clock volume battery rift_workspace_state workspace_state; do
  sketchybar --remove "$item" >/dev/null 2>&1 || true
done
sketchybar --remove '/rift_ws_.*/' >/dev/null 2>&1 || true
sketchybar --remove '/ws_.*/' >/dev/null 2>&1 || true
sketchybar --remove '/space\..*/' >/dev/null 2>&1 || true
sketchybar --remove chevron >/dev/null 2>&1 || true

##### Transparent bar; visual surfaces belong to capsules #####
sketchybar --bar position=top height=40 y_offset=5 margin=5 blur_radius=0 color=0x00000000 border_width=0

##### Shared item defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="Helvetica Neue:Regular:13.0"
  label.font="Helvetica Neue:Regular:13.0"
  icon.color=0xffe8eaf0
  label.color=0xffe8eaf0
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=5
  label.padding_right=5
  background.drawing=off
  updates=when_shown
)
sketchybar --default "${default[@]}"

##### Rift workspace section #####
sketchybar --add event rift_workspace_changed
sketchybar --add item workspaces_toggle left \
           --set workspaces_toggle label="Workspaces" \
             label.font="Helvetica Neue:Medium:13.0" \
             background.drawing=off \
             click_script="$PLUGIN_DIR/toggle_section.sh workspaces"

# The hidden controller queries Rift, creates/removes workspace items as its catalog changes,
# and refreshes active state on workspace, config, and native macOS display/space changes.
sketchybar --add item rift_workspace_state left \
           --set rift_workspace_state drawing=off updates=on script="$PLUGIN_DIR/workspace_sync.sh" \
           --subscribe rift_workspace_state rift_workspace_changed config_changed space_change display_change

##### Focused application capsule #####
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
             label="App" \
             label.max_chars=24 \
             background.drawing=on \
             background.color=0xe6171a20 \
             background.height=30 \
             background.corner_radius=10 \
             background.border_width=1 \
             background.border_color=0x283e4658 \
             script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Collapsible system section #####
sketchybar --add item system_toggle right \
           --set system_toggle label="Status" \
             label.font="Helvetica Neue:Medium:13.0" \
             background.drawing=off \
             click_script="$PLUGIN_DIR/toggle_section.sh system" \
           --add item clock right \
           --set clock update_freq=60 icon.drawing=off script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume icon.drawing=off label="Vol --" script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 icon.drawing=off script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

capsule=(
  background.drawing=on
  background.color=0xe6171a20
  background.height=30
  background.corner_radius=12
  background.border_width=1
  background.border_color=0x283e4658
)
sketchybar --add bracket system_capsule system_toggle clock volume battery \
           --set system_capsule "${capsule[@]}"

STATE_DIR="${TMPDIR:-/tmp}/sketchybar-rift-${UID:-$(id -u)}"
if [ -f "$STATE_DIR/system.collapsed" ]; then
  sketchybar --set system_toggle label="Status  ▸" \
             --set clock drawing=off \
             --set volume drawing=off \
             --set battery drawing=off
fi

# Start with the current Rift catalog, then initialize scripts and system indicators.
"$PLUGIN_DIR/workspace_sync.sh" --force
sketchybar --update
